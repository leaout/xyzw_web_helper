# 复制为 .env 并填入真实值（本地运行用；部署到 Render 时在面板里配）
PORT=3000

# Supabase 项目 -> Settings -> API 里获取
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 用 service_role key 或 anon key（若用 anon key，需保证 RLS 策略已按 supabase_schema.sql 放行）
SUPABASE_KEY=your-supabase-key-here

# 后端 API 鉴权密钥：自己设一个强随机字符串，前端要填同一个
API_KEY=change-me-to-a-long-random-string
