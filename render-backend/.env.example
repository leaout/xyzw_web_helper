# 复制为 .env（本地运行会自动读取；生产环境也可用 systemd EnvironmentFile）

# 服务监听端口与地址
PORT=3000
HOST=0.0.0.0

# 前端 dist 目录路径（留空则默认使用上一级目录的 dist）
#STATIC_DIR=/opt/xyzw/dist

# SQLite 数据库文件路径（留空则默认 render-backend/data/xyzw.db）
#DB_PATH=/opt/xyzw/data/xyzw.db

# 管理 API 鉴权密钥：公网部署强烈建议设置一个长随机串。
# 前端「后端同步」设置里要填同一个值。留空则免鉴权（仅限本地/内网）。
API_KEY=change-me-to-a-long-random-string

# 代理请求超时（毫秒，可选）
PROXY_TIMEOUT_MS=30000
